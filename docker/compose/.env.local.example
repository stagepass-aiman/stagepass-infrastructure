# =============================================================================
# .env.local.example — StagePass Infrastructure Environment Variables
#
# USAGE:
#   cp .env.local.example .env.local
#   # Edit .env.local with your local values
#   docker compose --env-file .env.local --profile infra up -d
#
# ⚠️  NEVER COMMIT .env.local — it is in .gitignore.
#     In Phase 9, Vault Agent Injector replaces this file entirely.
#     In Phase 2–8, these values are the "simulated Vault" for local dev.
#
# PASSWORD REQUIREMENTS:
#   - Minimum 16 characters
#   - Mix of upper, lower, digits, and symbols
#   - Use: openssl rand -base64 18 | tr -d '=+/' | cut -c1-20
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_16chars
POSTGRES_AUTH_PASSWORD=change_me_auth_16chars
POSTGRES_SEAT_PASSWORD=change_me_seat_16chars
POSTGRES_BOOKING_PASSWORD=change_me_booking_16chars
POSTGRES_PAYMENT_PASSWORD=change_me_payment_16chars
POSTGRES_DISBURSEMENT_PASSWORD=change_me_disbursement_16chars
POSTGRES_TICKET_PASSWORD=change_me_ticket_16chars
POSTGRES_CHECKIN_PASSWORD=change_me_checkin_16chars
POSTGRES_FRAUD_PASSWORD=change_me_fraud_16chars

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_ROOT_PASSWORD=change_me_mongo_root_16chars
MONGO_EVENT_PASSWORD=change_me_mongo_event_16chars
MONGO_VENUE_PASSWORD=change_me_mongo_venue_16chars
MONGO_BOOKING_READ_PASSWORD=change_me_mongo_bookingread_16chars

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_16chars

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_ADMIN_PASSWORD=change_me_kafka_admin_16chars
ZOOKEEPER_KAFKA_PASSWORD=change_me_zk_kafka_16chars
KAFKA_BOOKING_PASSWORD=change_me_kafka_booking
KAFKA_PAYMENT_PASSWORD=change_me_kafka_payment
KAFKA_SEAT_PASSWORD=change_me_kafka_seat
KAFKA_TICKET_PASSWORD=change_me_kafka_ticket
KAFKA_NOTIFICATION_PASSWORD=change_me_kafka_notification
KAFKA_FRAUD_PASSWORD=change_me_kafka_fraud
KAFKA_WAITLIST_PASSWORD=change_me_kafka_waitlist
KAFKA_EVENT_PASSWORD=change_me_kafka_event
KAFKA_VENUE_PASSWORD=change_me_kafka_venue
KAFKA_DISBURSEMENT_PASSWORD=change_me_kafka_disbursement
KAFKA_ANALYTICS_PASSWORD=change_me_kafka_analytics
KAFKA_SEARCH_PASSWORD=change_me_kafka_search
KAFKA_RECOMMENDATION_PASSWORD=change_me_kafka_recommendation

# ─── Elasticsearch ───────────────────────────────────────────────────────────
ELASTICSEARCH_PASSWORD=change_me_elastic_16chars

# ─── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=change_me_clickhouse_16chars

# ─── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_API_KEY=change_me_qdrant_api_key_32chars

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=stagepass-admin
MINIO_ROOT_PASSWORD=change_me_minio_16chars

# ─── Vault ───────────────────────────────────────────────────────────────────
VAULT_DEV_ROOT_TOKEN=stagepass-local-dev-token

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana_16chars

# ─── SonarQube (--profile ci only) ──────────────────────────────────────────
SONARQUBE_DB_PASSWORD=change_me_sonar_16chars